# 이 파일을 .env.local로 복사해서 사용하세요. (.env.local은 git에 올라가지 않습니다)
# 휴대폰(Expo Go)에서 접속하므로 localhost 대신 PC의 LAN IP를 적습니다. (ipconfig → IPv4 주소)
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api/v1

# 네이버 지도 키는 .env.local 이 아니라 .env 에 적습니다. (start_phone.bat이 .env.local을 덮어쓰기 때문)
# 네이버 클라우드 플랫폼 > Maps > Application 에서 발급한 Client ID (Android 패키지명·iOS 번들 ID: com.runnerp.app)
NAVER_MAP_CLIENT_ID=
